{
  "name": "taxiverz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "validate:data": "tsx scripts/validate-data.ts",
    "qa": "tsx scripts/qa.ts",
    "redirects:check": "tsx scripts/check-redirects.ts",
    "clean": "rimraf .next",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run validate:data && npm run build && npm run qa",
    "images:migrate": "tsx scripts/migrate-images.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "distances:fetch": "tsx scripts/fetch-distances.ts",
    "distances:apply": "tsx scripts/fetch-distances.ts --apply",
    "links:check": "tsx scripts/check-links.ts",
    "bundle:report": "tsx scripts/bundle-report.ts",
    "perf": "tsx scripts/perf.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.6",
    "@next/third-parties": "16.3.6",
    "@types/mdx": "^2.0.14",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "nodemailer": "10.0.12",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "lighthouse": "12.8.2",
    "node-html-parser": "9.0.4",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rimraf": "6.1.3",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
