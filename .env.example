# Copy to .env.local (git-ignored) and fill in. Every variable is optional in
# development; the site renders without any of them.
# Windows (cmd): copy .env.example .env.local

# ---- Analytics -------------------------------------------------------------
# Google Tag Manager container, e.g. GTM-XXXXXXX. Unset = no tag manager.
NEXT_PUBLIC_GTM_ID=
# Microsoft Clarity project id. Unset = no Clarity.
NEXT_PUBLIC_CLARITY_ID=

# ---- Lead outbox (Phase 3) -------------------------------------------------
# PostgreSQL database "taxiverz". Dev: local server on localhost:5432.
# e.g. postgres://taxiverz:password@localhost:5432/taxiverz
DATABASE_URL=
# Shared secret (24+ chars) for the VPS cron:
#   POST /api/leads/retry        every 5 minutes  (redelivers failed sinks)
#   POST /api/leads/maintenance  daily            (deletes leads 24 months after last contact)
# Header: Authorization: Bearer <token>
LEADS_RETRY_TOKEN=

# ---- Lead sinks (Phase 3) --------------------------------------------------
# Every lead goes to each sink that is configured. Configure at least one.
# Email (SMTP). Port 465 = TLS; 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=
# Telegram bot (message the bot once, then use your chat id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Webhook (Google Sheets Apps Script, n8n, a CRM). Signed with
# X-Taxiverz-Signature: <hex HMAC-SHA256 of the body with LEAD_WEBHOOK_SECRET>.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# ---- Route distances (before Phase 4B) -------------------------------------
# Google Maps Routes API key for scripts/fetch-distances.ts.
GOOGLE_MAPS_API_KEY=
