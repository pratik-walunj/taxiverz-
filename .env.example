# Copy to .env.local (git-ignored) and fill in. Every variable is optional in
# development; the site renders without any of them.
# Windows (cmd): copy .env.example .env.local

# ---- Analytics (tracking helper arrives in Phase 3) ------------------------
# Google Tag Manager container, e.g. GTM-XXXXXXX. Unset = no tag manager.
NEXT_PUBLIC_GTM_ID=
# Microsoft Clarity project id. Unset = no Clarity.
NEXT_PUBLIC_CLARITY_ID=

# ---- Lead outbox (Phase 3) -------------------------------------------------
# PostgreSQL database "taxiverz". Dev: local server on localhost:5432.
# e.g. postgres://taxiverz:password@localhost:5432/taxiverz
DATABASE_URL=
# Shared secret for POST /api/leads/retry (called by the VPS cron).
LEADS_RETRY_TOKEN=

# ---- Route distances (before Phase 4B) -------------------------------------
# Google Maps Routes API key for scripts/fetch-distances.ts.
GOOGLE_MAPS_API_KEY=
